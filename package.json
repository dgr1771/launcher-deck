{
  "name": "launcher-deck",
  "productName": "应用牌堆 Launcher Deck",
  "version": "0.2.7",
  "description": "应用牌堆——把本机所有程序洗成一副塔罗牌，零输入翻牌即达",
  "author": "隔壁村布布 (dgr1771)",
  "homepage": "https://github.com/dgr1771/launcher-deck",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.dgr1771.launcherdeck",
    "productName": "应用牌堆 Launcher Deck",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "assets/icon.ico",
      "assets/tray.png",
      "scripts/scan.ps1"
    ],
    "asarUnpack": [
      "scripts/scan.ps1",
      "assets/**"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "应用牌堆 Launcher Deck"
    }
  },
  "dependencies": {
    "pinyin-pro": "^3.29.3"
  },
  "license": "CC-BY-NC-4.0"
}